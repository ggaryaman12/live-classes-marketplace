{
  "schema": "yelo.tree/1",
  "page": "checkout",
  "root": "p1",
  "nodes": {
    "p1": {
      "id": "p1",
      "type": "Page",
      "props": {},
      "children": [
        "enroll",
        "recurringSummary",
        "checkout1"
      ]
    },
    "enroll": {
      "id": "enroll",
      "type": "Custom",
      "props": {
        "component": "EnrollHeader",
        "eyebrow": "Confirm your subscription"
      }
    },
    "recurringSummary": {
      "id": "recurringSummary",
      "type": "Custom",
      "props": {
        "component": "RecurringSummary",
        "heading": "Your schedule"
      }
    },
    "checkout1": {
      "id": "checkout1",
      "type": "Custom",
      "props": {
        "component": "ClassCheckout",
        "title": "Confirm & pay",
        "paymentLabel": "How you’ll pay",
        "summaryLabel": "Your enrollment",
        "ctaLabel": "Confirm & enroll",
        "allowCash": true,
        "allowWallet": false
      },
      "bind": {
        "source": "get_bill_breakdown"
      }
    }
  }
}
