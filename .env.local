# The storefront reads its page trees + tokens from the bundled data/ dir.
STUDIO_DATA_ROOT=./data
STUDIO_PREVIEW_TENANT=510012362__live-classes-markeptlace-2

# This storefront's name: the browser tab title and the header wordmark.
# Both forms are needed — the server reads STUDIO_SITE_NAME, and the header is a
# client component so it can only see NEXT_PUBLIC_*, inlined at build time.
STUDIO_SITE_NAME=Live Classes Markeptlace 2
NEXT_PUBLIC_SITE_NAME=Live Classes Markeptlace 2
